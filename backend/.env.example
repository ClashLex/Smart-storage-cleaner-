# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27107/smart_cleaner

# JWT Secret for Session Management
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Firebase Admin SDK Configuration (JSON string)
# Keep single-lined or specify path to credentials JSON
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "smart-cleaner-ai", ...}

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google Play Developer API V3 credentials for billing verification
# Private key and client email of a Service Account with access to Google Play Developer Console
GOOGLE_PLAY_CLIENT_EMAIL=play-billing-service@your-project.iam.gserviceaccount.com
GOOGLE_PLAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GOOGLE_PLAY_PACKAGE_NAME=com.aistudio.smartcleaner

# Admin API Authorization Token
ADMIN_SECRET_KEY=highly_secure_admin_bypass_token
