# Server
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/smart_cleaner
CORS_ORIGINS=http://localhost:5173,https://your-dashboard.example.com

# Required in production (use a unique random value of at least 32 characters)
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Firebase Admin SDK service account JSON (single-line JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google Play Developer API service account
GOOGLE_PLAY_CLIENT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=com.aistudio.smartcleaner.xjpzqd

# Google Pub/Sub push authentication
PUBSUB_OIDC_AUDIENCE=
PUBSUB_OIDC_EMAIL=
